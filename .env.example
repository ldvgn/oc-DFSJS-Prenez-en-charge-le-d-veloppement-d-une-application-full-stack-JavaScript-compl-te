# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_PORT=5432
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used by Better Auth to sign session cookies and encrypt sensitive data.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Analysis token for local SonarQube (npm run sonar)
SONAR_TOKEN=
